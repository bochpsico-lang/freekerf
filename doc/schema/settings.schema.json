{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Settings",
  "description": "The whole settings file.",
  "type": "object",
  "properties": {
    "automation": {
      "description": "Automation (user-only).",
      "$ref": "#/$defs/AutomationSettings",
      "default": {
        "grants": [],
        "mcp": {
          "allow_machine": false,
          "enabled": false
        }
      }
    },
    "buttons": {
      "description": "Custom buttons of the machine panel (added in M4a; none by default).",
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/CustomButton"
      }
    },
    "job": {
      "description": "Job custom code.",
      "$ref": "#/$defs/JobSettings",
      "default": {
        "footer": "G0 X0 Y0 Z0 (move back to origin)",
        "header": "G90 (use absolute coordinates)",
        "passes": ";(Uncomment if you want to sink Z axis)\n;G91 (use relative coordinates)\n;G0 Z-1 (sinks the Z axis, 1mm)\n;G90 (use absolute coordinates)"
      }
    },
    "jog": {
      "description": "Jog.",
      "$ref": "#/$defs/JogSettings",
      "default": {
        "speed_mm_min": 1000.0,
        "step_mm": 1.0
      }
    },
    "machine": {
      "description": "Machine connection.",
      "$ref": "#/$defs/MachineSettings",
      "default": {
        "accept_broken_ok": true,
        "auto_cooling": {
          "enabled": false,
          "off_s": 60,
          "on_s": 600
        },
        "baud": 115200,
        "continuous_jog": false,
        "firmware": "Grbl",
        "port": null,
        "query_machine_info": true,
        "reset_on_connect": true,
        "status_query_ms": 500,
        "streaming_mode": "Buffered",
        "support_pwm": true
      }
    },
    "safety": {
      "description": "Safety (user-only; added in M4a).",
      "$ref": "#/$defs/SafetySettings",
      "default": {
        "fire_countdown_s": 3
      }
    },
    "ui": {
      "description": "Appearance of the desktop app (added in M4a; files without it get the defaults).",
      "$ref": "#/$defs/UiSettings",
      "default": {
        "density": "auto",
        "high_contrast": false,
        "language": "auto",
        "theme": "dark",
        "units": "mm"
      }
    },
    "version": {
      "description": "Format version.",
      "type": "integer",
      "format": "uint32",
      "default": 2,
      "minimum": 0
    }
  },
  "additionalProperties": false,
  "$defs": {
    "AutoCoolingSettings": {
      "description": "Automatic cooling: hold the job `off_s` every `on_s` seconds of work.",
      "type": "object",
      "properties": {
        "enabled": {
          "description": "Enabled.",
          "type": "boolean",
          "default": false
        },
        "off_s": {
          "description": "Pause, seconds.",
          "type": "integer",
          "format": "uint64",
          "default": 60,
          "minimum": 0
        },
        "on_s": {
          "description": "Work time, seconds.",
          "type": "integer",
          "format": "uint64",
          "default": 600,
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "AutomationSettings": {
      "description": "Automation (scripts and agents).",
      "type": "object",
      "properties": {
        "grants": {
          "description": "Permissions granted \"always\" (revoked by removing them).",
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/Grant"
          }
        },
        "mcp": {
          "description": "MCP.",
          "$ref": "#/$defs/McpSettings",
          "default": {
            "allow_machine": false,
            "enabled": false
          }
        }
      },
      "additionalProperties": false
    },
    "CallerKind": {
      "description": "Who calls an action.",
      "oneOf": [
        {
          "description": "A person, through the UI or the CLI.",
          "type": "string",
          "const": "user"
        },
        {
          "description": "A user macro (script).",
          "type": "string",
          "const": "macro"
        },
        {
          "description": "An AI agent through MCP.",
          "type": "string",
          "const": "agent"
        },
        {
          "description": "A test harness (`host --stdio`).",
          "type": "string",
          "const": "test"
        }
      ]
    },
    "CustomButton": {
      "description": "A custom button of the machine panel: G-code (custom code with `[expr]`) run on\na click. Running it can turn the laser on, so it goes through the fire\nconfirmation (`machine.custom_code`, tier `laser`).",
      "type": "object",
      "properties": {
        "code": {
          "description": "Custom code (`[expr]` allowed; `!`, `~`, `?`, `ctrl-x`, `0xNN` sent at once).",
          "type": "string",
          "default": ""
        },
        "icon": {
          "description": "Icon name of the design system (`target`, `air`...), optional.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "label": {
          "description": "Label.",
          "type": "string",
          "default": ""
        }
      },
      "additionalProperties": false
    },
    "Density": {
      "description": "Size of controls.",
      "oneOf": [
        {
          "description": "From the last input used: touch → comfortable, mouse or pen → compact.",
          "type": "string",
          "const": "auto"
        },
        {
          "description": "Mouse and pen.",
          "type": "string",
          "const": "compact"
        },
        {
          "description": "Touch (44 px targets).",
          "type": "string",
          "const": "comfortable"
        }
      ]
    },
    "Firmware": {
      "description": "Firmware family.",
      "oneOf": [
        {
          "description": "Grbl, grblHAL and compatible.",
          "type": "string",
          "const": "Grbl"
        },
        {
          "description": "Smoothieware.",
          "type": "string",
          "const": "Smoothie"
        },
        {
          "description": "Marlin.",
          "type": "string",
          "const": "Marlin"
        },
        {
          "description": "VigoWork.",
          "type": "string",
          "const": "VigoWork"
        }
      ]
    },
    "Grant": {
      "description": "A permission granted by the user with the scope \"always\" (PLAN §9.5): `caller`\nnamed `name` may use actions up to `tier` without asking.",
      "type": "object",
      "properties": {
        "caller": {
          "description": "Kind of caller (`macro`, `agent`).",
          "$ref": "#/$defs/CallerKind"
        },
        "code_hash": {
          "description": "Macros: hash of the code; editing the macro invalidates the grant.",
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "description": "Caller name (macro name, MCP client name).",
          "type": "string"
        },
        "tier": {
          "description": "Highest tier granted.",
          "$ref": "#/$defs/Tier"
        }
      },
      "additionalProperties": false,
      "required": [
        "caller",
        "name",
        "tier"
      ]
    },
    "JobSettings": {
      "description": "Code around jobs.",
      "type": "object",
      "properties": {
        "footer": {
          "description": "After the program.",
          "type": "string",
          "default": "G0 X0 Y0 Z0 (move back to origin)"
        },
        "header": {
          "description": "Before the program (`[expr]` allowed; `!`, `~`, `?`, `ctrl-x`, `0xNN` are sent at once).",
          "type": "string",
          "default": "G90 (use absolute coordinates)"
        },
        "passes": {
          "description": "Between passes.",
          "type": "string",
          "default": ";(Uncomment if you want to sink Z axis)\n;G91 (use relative coordinates)\n;G0 Z-1 (sinks the Z axis, 1mm)\n;G90 (use absolute coordinates)"
        }
      },
      "additionalProperties": false
    },
    "JogSettings": {
      "description": "Jog defaults.",
      "type": "object",
      "properties": {
        "speed_mm_min": {
          "description": "Feed, mm/min.",
          "type": "number",
          "format": "double",
          "default": 1000.0
        },
        "step_mm": {
          "description": "Step, mm.",
          "type": "number",
          "format": "double",
          "default": 1.0
        }
      },
      "additionalProperties": false
    },
    "MachineSettings": {
      "description": "How to reach the machine and how to talk to it.",
      "type": "object",
      "properties": {
        "accept_broken_ok": {
          "description": "Count a garbled line that contains `ok` as an `ok` (tolerates a noisy link).",
          "type": "boolean",
          "default": true
        },
        "auto_cooling": {
          "description": "Automatic cooling cycles.",
          "$ref": "#/$defs/AutoCoolingSettings",
          "default": {
            "enabled": false,
            "off_s": 60,
            "on_s": 600
          }
        },
        "baud": {
          "description": "Baud rate.",
          "type": "integer",
          "format": "uint32",
          "default": 115200,
          "minimum": 0
        },
        "continuous_jog": {
          "description": "Continuous jog (jog while pressed).",
          "type": "boolean",
          "default": false
        },
        "firmware": {
          "description": "Firmware family.",
          "$ref": "#/$defs/Firmware",
          "default": "Grbl"
        },
        "port": {
          "description": "Last serial port used.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "query_machine_info": {
          "description": "Ask `$I` when connecting.",
          "type": "boolean",
          "default": true
        },
        "reset_on_connect": {
          "description": "Soft reset when connecting.",
          "type": "boolean",
          "default": true
        },
        "status_query_ms": {
          "description": "Status query period, ms.",
          "type": "integer",
          "format": "uint64",
          "default": 500,
          "minimum": 0
        },
        "streaming_mode": {
          "description": "Streaming mode.",
          "$ref": "#/$defs/Streaming",
          "default": "Buffered"
        },
        "support_pwm": {
          "description": "Hardware PWM: `S0` does not burn.",
          "type": "boolean",
          "default": true
        }
      },
      "additionalProperties": false
    },
    "McpSettings": {
      "description": "MCP server settings (§9 of the plan). Changed only by the user, never by\nactions, scripts or agents.",
      "type": "object",
      "properties": {
        "allow_machine": {
          "description": "Agents may use `machine` actions. Agents never get `laser` actions.",
          "type": "boolean",
          "default": false
        },
        "enabled": {
          "description": "MCP server enabled (off by default).",
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": false
    },
    "SafetySettings": {
      "description": "Safety settings: user-only, like automation (actions, scripts and agents cannot\nchange them).",
      "type": "object",
      "properties": {
        "fire_countdown_s": {
          "description": "Seconds before \"Fire laser\" can be pressed (1-10, default 3).",
          "type": "integer",
          "format": "uint64",
          "default": 3,
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "Streaming": {
      "description": "Streaming mode.",
      "oneOf": [
        {
          "description": "Fill the RX buffer (character counting).",
          "type": "string",
          "const": "Buffered"
        },
        {
          "description": "One line at a time.",
          "type": "string",
          "const": "Synchronous"
        },
        {
          "description": "One line at a time, failed job lines retried 3 times.",
          "type": "string",
          "const": "RepeatOnError"
        }
      ]
    },
    "Theme": {
      "description": "Colour theme of the app.",
      "oneOf": [
        {
          "description": "Dark (default: workshops with little light).",
          "type": "string",
          "const": "dark"
        },
        {
          "description": "Light.",
          "type": "string",
          "const": "light"
        }
      ]
    },
    "Tier": {
      "description": "Permission tier of an action, from least to most powerful (`Safety` is special:\nalways allowed, because it only makes the machine safer).",
      "oneOf": [
        {
          "description": "STOP, feed hold, abort: always allowed.",
          "type": "string",
          "const": "safety"
        },
        {
          "description": "Reading state.",
          "type": "string",
          "const": "read"
        },
        {
          "description": "Selection, panels, view.",
          "type": "string",
          "const": "ui"
        },
        {
          "description": "Changing the document or settings.",
          "type": "string",
          "const": "edit"
        },
        {
          "description": "Moving the machine, changing its settings.",
          "type": "string",
          "const": "machine"
        },
        {
          "description": "Anything that can turn the laser on.",
          "type": "string",
          "const": "laser"
        }
      ]
    },
    "UiSettings": {
      "description": "Appearance of the desktop app.",
      "type": "object",
      "properties": {
        "density": {
          "description": "Density of the controls.",
          "$ref": "#/$defs/Density",
          "default": "auto"
        },
        "high_contrast": {
          "description": "High contrast (on top of the theme).",
          "type": "boolean",
          "default": false
        },
        "language": {
          "description": "Language: `auto` (the system's) or a locale of `ui/i18n` (`en`, `pt-BR`, `de`...).",
          "type": "string",
          "default": "auto"
        },
        "theme": {
          "description": "Theme.",
          "$ref": "#/$defs/Theme",
          "default": "dark"
        },
        "units": {
          "description": "Units shown.",
          "$ref": "#/$defs/Units",
          "default": "mm"
        }
      },
      "additionalProperties": false
    },
    "Units": {
      "description": "Length units shown in the app (the machine always works in mm).",
      "oneOf": [
        {
          "description": "Millimetres.",
          "type": "string",
          "const": "mm"
        },
        {
          "description": "Inches.",
          "type": "string",
          "const": "in"
        }
      ]
    }
  }
}
